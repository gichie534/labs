# Copy to .env and fill in. `.env` is gitignored.

# Region everything is created in.
AWS_REGION=us-east-1

# Globally-unique S3 bucket that stores this lab's Terraform state.
TF_STATE_BUCKET=REPLACE_WITH_STATE_BUCKET

# Optional: override the two AZs if your account lacks the first two lexical AZs
# (e.g. us-east-1a is a wavelength/local zone in some accounts).
# AWS_AZS=us-east-1a,us-east-1b
