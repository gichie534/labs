# Copy to .env and fill in (`task init-env` does this for you). `.env` is gitignored.

# ---------------------------------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------------------------------

# Globally-unique S3 bucket that stores this lab's Terraform state.
TF_STATE_BUCKET=REPLACE_WITH_STATE_BUCKET

# Where alerts go. Every budget threshold and every anomaly alert lands here, so this is the one value
# that decides whether the lab is useful or decorative. You will get an AWS confirmation email that you
# MUST click — until you do, the channel is silent. `task verify` reports on that.
FINOPS_ALERT_EMAIL=REPLACE_WITH_YOUR_EMAIL

# Globally-unique S3 bucket for the CUR 2.0 cost and usage export. This is the only resource in the lab
# with an ongoing charge (standard S3 rates for a few MB a month; the export service itself is free).
FINOPS_EXPORT_BUCKET=REPLACE_WITH_EXPORT_BUCKET

# ---------------------------------------------------------------------------------------------------
# Thresholds — defaults are deliberately low so a quiet account still trips something
# ---------------------------------------------------------------------------------------------------

# Monthly cost limit in USD. Alerts fire at 50%, 80% and 100% of actual spend, plus 100% of AWS's
# forecast for the month.
FINOPS_MONTHLY_BUDGET_USD=50

# Anomaly alert floor in USD: ignore anomalies whose total cost impact is below this.
FINOPS_ANOMALY_ABSOLUTE_USD=10

# Anomaly alert floor as a percentage overshoot of expected spend. Combined with the absolute floor
# using OR — an absolute floor alone sleeps through a steady overspend on a big bill, a percentage
# alone fires on a $2 service that tripled.
FINOPS_ANOMALY_PERCENTAGE=50

# ---------------------------------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------------------------------

# Comma-separated user-defined tag keys to activate as cost allocation tags, e.g. "Lab,ManagedBy".
#
# Empty by default and that is not laziness: AWS only accepts activation for tag keys it has ALREADY
# discovered on a real resource, which takes up to 24h after the tag first appears. Listing a key too
# early makes `terraform apply` fail. Run the lab once, wait a day, then set this and re-apply.
FINOPS_COST_ALLOCATION_TAG_KEYS=
