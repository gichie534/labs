# Copy to .env (`task init-env`) and fill in. `.env` is gitignored.

# Region everything is created in. Redshift Serverless and the Redshift Data API must both be
# available here; us-east-1 is a safe default.
AWS_REGION=us-east-1

# Globally-unique S3 bucket that stores this lab's Terraform state.
TF_STATE_BUCKET=REPLACE_WITH_STATE_BUCKET

# Globally-unique S3 bucket that receives BOTH ingestion paths (not the state bucket):
#   batch/   <- written directly by `task upload`
#   stream/  <- written by Firehose after its buffer flushes
#   errors/  <- records Firehose failed to deliver
DATA_BUCKET=REPLACE_WITH_GLOBALLY_UNIQUE_DATA_BUCKET
