# Copy to `.env` and fill in. The Taskfile loads `.env` automatically (dotenv); `.env` is gitignored.
# Values already exported in your shell take precedence over these.
#
# Format: KEY=value (no `export`, no spaces around `=`). Quote values containing spaces.

# --- Core GCP ---
GCP_PROJECT=my-project
GCP_REGION=us-central1

# --- Terraform state ---
TF_STATE_BUCKET=my-tf-state-bucket

# --- Public DNS (delegated child zone apex; hosts derive from it) ---
# argocd.$BASE_DOMAIN and grafana.$BASE_DOMAIN are served over HTTPS. external-dns creates the
# A records; Terraform creates the zone + cert-authorization CNAMEs.
BASE_DOMAIN=vm.gke.example.com

# --- Parent DNS zone (delegation target). Keep this in a DIFFERENT project from GCP_PROJECT so
# --- external-dns (scoped to GCP_PROJECT) can't touch the parent zone. ---
PARENT_DNS_ZONE=gke-example-com
PARENT_DNS_PROJECT=my-bootstrap-project

# --- Google Workspace / Cloud Identity domain (who may sign in) ---
WORKSPACE_DOMAIN=example.com

# --- Argo CD SSO: direct Google OIDC (no Dex, no groups) ---
# OAuth 2.0 Web client (Cloud console). Redirect URI: https://argocd.$BASE_DOMAIN/auth/callback
ARGOCD_OIDC_CLIENT_ID=1234567890-argocd.apps.googleusercontent.com
ARGOCD_OIDC_CLIENT_SECRET=GOCSPX-replace_with_argocd_client_secret
ARGOCD_ADMIN_EMAIL=you@example.com

# --- Grafana SSO: Google OAuth ---
# A SEPARATE OAuth 2.0 Web client. Redirect URI: https://grafana.$BASE_DOMAIN/login/google
GRAFANA_OAUTH_CLIENT_ID=1234567890-grafana.apps.googleusercontent.com
GRAFANA_OAUTH_CLIENT_SECRET=GOCSPX-replace_with_grafana_client_secret
GRAFANA_ADMIN_EMAIL=you@example.com

# --- Private infra repo (Argo CD GitOps source) + GitHub App (Argo CD's read credential) ---
# Create a GitHub App, install it on the private repo (Contents: read-only), and download its key.
INFRA_REPO_URL=https://github.com/your-org/gke-argocd-victoriametrics-infra.git
INFRA_REPO_DIR=../gke-argocd-victoriametrics-infra   # local checkout of the private repo (any path)
GITHUB_APP_ID=123456
GITHUB_APP_INSTALLATION_ID=12345678
GITHUB_APP_PRIVATE_KEY_PATH=./github-app.private-key.pem   # gitignored; seeded into Secret Manager
