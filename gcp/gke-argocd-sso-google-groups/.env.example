# Copy to `.env` and fill in. The Taskfile loads `.env` automatically (dotenv); `.env` is gitignored.
# Values already exported in your shell take precedence over these.
#
# Format: KEY=value (no `export`, no spaces around `=`). Quote values containing spaces.

# --- Core GCP ---
GCP_PROJECT=my-project
GCP_REGION=us-central1

# --- Terraform state ---
TF_STATE_BUCKET=my-tf-state-bucket

# --- Public HTTPS endpoint (Argo CD UI/API) ---
ARGOCD_DOMAIN=argocd.gke.example.com

# --- Parent DNS zone (delegation target) ---
PARENT_DNS_ZONE=gke-example-com
PARENT_DNS_PROJECT=my-bootstrap-project

# --- Google Workspace SSO (Dex Google connector) ---
# OAuth 2.0 Web client, created MANUALLY in the Cloud console (APIs & Services -> Credentials).
# Authorized redirect URI must be: https://<ARGOCD_DOMAIN>/api/dex/callback
OAUTH_CLIENT_ID=1234567890-abcdefg.apps.googleusercontent.com
OAUTH_CLIENT_SECRET=GOCSPX-replace_with_client_secret
# A Workspace SUPER-ADMIN email for Dex to impersonate when reading group membership.
DEX_ADMIN_EMAIL=admin@example.com

# --- Multi-tenant RBAC: Workspace group emails mapped to Argo CD roles ---
# Members of ADMIN_GROUP get full admin; TEAM_A/TEAM_B groups get scoped access to their project.
ADMIN_GROUP=argocd-admins@example.com
TEAM_A_GROUP=argocd-team-a@example.com
TEAM_B_GROUP=argocd-team-b@example.com
