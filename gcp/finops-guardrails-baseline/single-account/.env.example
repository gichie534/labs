# Copy to .env and fill in (`task init-env` does this for you). `.env` is gitignored.
# Values already exported in your shell take precedence over these.
# Format: KEY=value (no `export`, no spaces around `=`).

# ---------------------------------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------------------------------

# The project the guardrails watch. It also hosts the alert channel, the budget topic and the export dataset.
GCP_PROJECT=REPLACE_WITH_PROJECT_ID

# Project NUMBER (not ID). Budgets filter on it and the API accepts nothing else.
#   gcloud projects describe "$GCP_PROJECT" --format='value(projectNumber)'
GCP_PROJECT_NUMBER=REPLACE_WITH_PROJECT_NUMBER

# The billing account that pays for GCP_PROJECT. Budgets are created ON this account, so your identity needs
# roles/billing.costsManager (or roles/billing.admin) on it — project Owner is not enough.
#   gcloud billing projects describe "$GCP_PROJECT" --format='value(billingAccountName)'   # strip billingAccounts/
GCP_BILLING_ACCOUNT=REPLACE_WITH_BILLING_ACCOUNT_ID

# GCS bucket for this lab's Terraform state (`task init-state` creates it).
TF_STATE_BUCKET=REPLACE_WITH_STATE_BUCKET

# Where threshold alerts go. Unlike SNS there is no confirmation email — the channel is live immediately,
# which also means nothing catches a typo. `task verify` prints it back.
FINOPS_ALERT_EMAIL=REPLACE_WITH_YOUR_EMAIL

# ---------------------------------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------------------------------

# Region for the state bucket only. Nothing else in this lab is regional.
GCP_REGION=us-central1

# Monthly limit, in the BILLING ACCOUNT'S currency (no currency is set on the budget, so it can never
# mismatch). Alerts at 50/80/100% of current spend plus 100% of forecast.
FINOPS_MONTHLY_BUDGET=50

# Export dataset location. Keep a multi-region (US or EU): only those get the current and previous month
# backfilled when you enable the export. Immutable once created. See docs/adr/0002.
FINOPS_EXPORT_DATASET_LOCATION=US
