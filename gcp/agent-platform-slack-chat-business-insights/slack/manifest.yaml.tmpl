# Slack app manifest. `task slack:manifest` prints it with the ingress URL filled in; paste it at
# https://api.slack.com/apps -> Create New App -> From a manifest, in your test workspace.
display_information:
  name: Business Insights
  description: Ask about TheLook customers, orders, revenue and web activity.
  background_color: "#1d4e89"
features:
  app_home:
    home_tab_enabled: false
    messages_tab_enabled: true
    messages_tab_read_only_enabled: false
  bot_user:
    display_name: business-insights
    always_online: true
oauth_config:
  scopes:
    bot:
      - app_mentions:read
      - chat:write
      - im:history
      - im:read
      - reactions:write
settings:
  event_subscriptions:
    request_url: __INGRESS_URL__/slack/events
    bot_events:
      - app_mention
      - message.im
  org_deploy_enabled: false
  socket_mode_enabled: false
  token_rotation_enabled: false
