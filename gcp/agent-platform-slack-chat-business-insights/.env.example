# Copy to `.env` (task init-env) and fill in. The Taskfile loads `.env` automatically (dotenv); `.env` is gitignored.
# Values already exported in your shell take precedence. Format: KEY=value (no `export`, no spaces around `=`).

# --- Core GCP ---------------------------------------------------------------------------------------------------
# A project inside your organization (Agent Identity uses the org trust domain agents.global.org-<ORG>.system.id.goog).
GCP_PROJECT=my-agent-lab
# gcloud projects describe "$GCP_PROJECT" --format='value(projectNumber)'
GCP_PROJECT_NUMBER=123456789012
# Agent Runtime, Cloud SQL, Cloud Run and Agent Gateway region.
GCP_REGION=us-central1

# --- Terraform state ----------------------------------------------------------------------------------------------
# Created by `task init-state`.
TF_STATE_BUCKET=my-agent-lab-tfstate

# --- Alerts -------------------------------------------------------------------------------------------------------
# Receives the observability alerts (agent 5xx, latency, permission denied, bridge errors).
ALERT_EMAIL=you@example.com

# --- CI (GitHub Actions -> GCP Workload Identity Federation) -------------------------------------------------------
# OWNER/REPO allowed to federate into the lab's GitHub WIF pool.
GITHUB_REPOSITORY=owner/repo

# --- Slack (your test workspace) -----------------------------------------------------------------------------------
# From the Slack app created with `task slack:manifest`. Stored in Secret Manager by `task slack:secrets`; never
# passed to Terraform.
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
# Comma-separated channel IDs the bot answers in (DMs are always allowed). Empty = any channel it's invited to.
SLACK_ALLOWED_CHANNELS=

# --- Agent --------------------------------------------------------------------------------------------------------
# Set automatically from Terraform output when empty; set it explicitly to skip the lookup.
AGENT_ENGINE_ID=
# Your identity, e.g. user:you@example.com. Lets `task dev` / `task eval` borrow the bi-crm-reader service account
# for Cloud SQL the same way the agent does (Owner alone can't mint its tokens). Empty = only the agent can.
DEVELOPER_MEMBER=
BI_MODEL=gemini-3.8-flash
BI_MODEL_LOCATION=global
# Prompts and answers in Cloud Trace spans. true is great for learning; set false for anything real.
CAPTURE_MESSAGE_CONTENT=true
# Agent Runtime scaling, applied with every release (versioned with the code).
AGENT_MIN_INSTANCES=0
AGENT_MAX_INSTANCES=3
AGENT_CPU=2
AGENT_MEMORY=4Gi
AGENT_CONCURRENCY=5
# Months of history `task seed` copies into the lab.
SEED_MONTHS=6

# --- Agent Gateway (preview; needs early-access enrollment) --------------------------------------------------------
# 1. ENABLE_AGENT_GATEWAY=true + `task gateway:up`   -> gateway, registry entries, egress policy (dry run)
# 2. `task gateway:bind`                             -> the agent's egress goes through the gateway
# 3. AGENT_GATEWAY_ENFORCE=true + `task gateway:up`  -> enforce instead of dry run, once the logs are clean
ENABLE_AGENT_GATEWAY=false
AGENT_GATEWAY_ENFORCE=false
