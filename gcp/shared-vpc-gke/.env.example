# Copy to `.env` and fill in (`task shared-vpc:init-env`). The Taskfile loads `.env` automatically
# (dotenv); `.env` is gitignored. Values already exported in your shell take precedence.
#
# Format: KEY=value (no `export`, no spaces around `=`). Quote values containing spaces.

# --- GCP organization + billing (the projects are created under these) ---
# gcloud organizations list
GCP_ORG_ID=000000000000
# gcloud billing accounts list
GCP_BILLING_ACCOUNT=XXXXXX-XXXXXX-XXXXXX

# --- Region for the host subnet, Cloud NAT, and the regional Autopilot cluster ---
GCP_REGION=us-central1

# --- The two projects the lab creates (must be GLOBALLY UNIQUE project IDs) ---
HOST_PROJECT_ID=my-shared-vpc-host
SERVICE_PROJECT_ID=my-gke-service

# --- Terraform/Terragrunt remote state (GCS) ---
# Bucket name (no gs:// prefix); created by `task shared-vpc:init-state`.
TF_STATE_BUCKET=my-tf-state-bucket
# Project that OWNS the state bucket (typically a pre-existing bootstrap project, not the two above).
TF_STATE_PROJECT=my-bootstrap-project
# Location for the state bucket.
TF_STATE_LOCATION=us-central1
