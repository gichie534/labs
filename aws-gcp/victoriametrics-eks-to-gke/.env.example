# Copy to `.env` and fill in. The Taskfile loads `.env` automatically (dotenv); `.env` is gitignored.
# Values already exported in your shell take precedence over these.
#
# Format: KEY=value (no `export`, no spaces around `=`).

# --- Core GCP (target: GKE + the VictoriaMetrics/VictoriaLogs destination) ---
GCP_PROJECT=my-project
GCP_REGION=us-central1

# --- Core AWS (source: EKS + the VictoriaMetrics/VictoriaLogs origin) ---
# Your AWS credentials (for `terragrunt apply`) come from your normal AWS CLI environment
# (profile / SSO / env vars) — only the region is set here.
AWS_REGION=us-east-1

# --- Terraform state ---
# A single GCS bucket holds state for BOTH the aws/* and gcp/* units. `task init-state` creates it.
TF_STATE_BUCKET=my-tf-state-bucket

# --- Seed dataset ---
# How many days of BACKDATED history the seed job writes into the source. This is the data whose
# migration gets verified, so it is deliberately deterministic: fixed series, fixed timestamps,
# fixed values. 7 days over a 5-minute step is ~24k samples and ~10k log lines — seconds to write.
#
# Must stay well below the 30d retention configured on both sides, or the backdated samples are
# rejected on ingest for being older than retention.
SEED_DAYS=7

# --- Operator access ---
# No bastion and no public data path. Both Kubernetes API servers keep a public endpoint so your
# kubectl works from anywhere; the VictoriaMetrics/VictoriaLogs data path is private-only, reachable
# solely over the VPN. Grafana is reached with `task grafana` (kubectl port-forward), so this lab
# needs no domain, no certificate and no OAuth client.
#
# LAB TRADEOFF: the API server endpoints allow 0.0.0.0/0. Narrow these to your own address for
# anything longer-lived — see docs/adr/0001.
