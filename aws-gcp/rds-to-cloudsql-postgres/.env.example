# Copy to `.env` and fill in. The Taskfile loads `.env` automatically (dotenv); `.env` is gitignored.
# Values already exported in your shell take precedence over these.
#
# Format: KEY=value (no `export`, no spaces around `=`).

# --- Core GCP (target: Cloud SQL) ---
GCP_PROJECT=my-project
GCP_REGION=us-central1

# --- Core AWS (source: RDS) ---
# Your AWS credentials (for `terragrunt apply`) come from your normal AWS CLI environment
# (profile / SSO / env vars) — only the region is set here.
AWS_REGION=us-east-1

# --- Terraform state ---
TF_STATE_BUCKET=my-tf-state-bucket

# --- Operator access ---
# No operator IP is needed: the migration runs on a Compute Engine host inside the GCP VPC, which you
# reach over IAP SSH (`gcloud compute ssh --tunnel-through-iap`, opened by `task ssh`). Your gcloud
# identity needs roles/iap.tunnelResourceAccessor + compute SSH access on the project (a project
# Owner has these). The RDS security group is scoped to the migration host's egress IP automatically.

# --- Source RDS credentials (master/admin) ---
RDS_MASTER_USERNAME=postgres
RDS_MASTER_PASSWORD=change-me-source-admin

# --- Target Cloud SQL admin (the built-in `postgres` user) ---
# The migration restores as this user (a member of cloudsqlsuperuser).
CLOUDSQL_ADMIN_PASSWORD=change-me-target-admin

# --- Application login-role password ---
# Password assigned to every seeded application login role (svc_sales, svc_billing, report_reader)
# on the target at cutover. In a real migration you'd set each role's real password here.
APP_DB_PASSWORD=change-me-app-role
